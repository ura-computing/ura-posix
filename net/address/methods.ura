pub fn create(port i32) Address:
    address Address = {
        raw: {
            sin_family: cstd::AF_INET as u16,
            sin_port: cstd::htons(port as u16),
            sin_addr: {
                s_addr: cstd::INADDR_ANY
            }
        },
    }
    return address

pub fn create(ip String, port i32) Address:
    address Address = Address::create(port)
    if cstd::inet_pton(cstd::AF_INET, ip.chars(), &address.raw.sin_addr) != 1:
        throw fail($"inet_pton {ip}")
    return address

fn port() i32:
    return cstd::ntohs(self.raw.sin_port) as i32
