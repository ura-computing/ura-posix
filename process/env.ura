fn get(name String) String:
    value char[] = cstd::getenv(name.chars())
    if value == null:
        return ""
    return String::create(value)

fn has(name String) bool:
    return cstd::getenv(name.chars()) != null

fn set(name String, value String):
    cstd::setenv(name.chars(), value.chars(), 1)

fn unset(name String):
    cstd::unsetenv(name.chars())
