# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Secrets — NEVER commit real env values; .env.example tracked separately
.env
.env.local
.env.*.local
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Vite
node_modules/
dist/
build/
.vite/
*.log
npm-debug.log*
yarn-debug.log*

# Coverage / temp
.coverage
htmlcov/
*.tmp

# Design handoff files (presentational TSX — not wired)
handoff/

# Claude Code: .claude/ (rules + shared settings) is committed; personal settings are not
.claude/settings.local.json

# Raw Sobrus CSV exports dropped into resources/ (test data, not source)
resources/Sobrus*

# E2E data generated by resources/tests/generate.py (regenerated every run)
resources/tests/**/*.csv
resources/tests/expected.json
resources/tests/catalog/product-infos.json

# Production database dumps — never commit
*.dump
