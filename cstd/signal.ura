// signal.h

SIGHUP i32 = 1
SIGINT i32 = 2
SIGQUIT i32 = 3
SIGILL i32 = 4
SIGTRAP i32 = 5
SIGABRT i32 = 6
SIGFPE i32 = 8
SIGKILL i32 = 9
SIGSEGV i32 = 11
SIGPIPE i32 = 13
SIGALRM i32 = 14
SIGTERM i32 = 15
@if os == "macos":
    SIGBUS i32 = 10
    SIGUSR1 i32 = 30
    SIGUSR2 i32 = 31
    SIGCHLD i32 = 20
    SIGCONT i32 = 19
    SIGSTOP i32 = 17
    SIGTSTP i32 = 18
    SIGWINCH i32 = 28
@else:
    SIGBUS i32 = 7
    SIGUSR1 i32 = 10
    SIGUSR2 i32 = 12
    SIGCHLD i32 = 17
    SIGCONT i32 = 18
    SIGSTOP i32 = 19
    SIGTSTP i32 = 20
    SIGWINCH i32 = 28

proto raise(sig i32) i32
proto kill(pid i32, sig i32) i32
proto signal(sig i32, handler i8[]) i8[]
