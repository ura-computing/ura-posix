// sys/stat.h

struct stat:
    @if os == "macos":
        st_dev i32
        st_mode u16
        st_nlink u16
        st_ino u64
        st_uid u32
        st_gid u32
        st_rdev i32
        st_atim timespec
        st_mtim timespec
        st_ctim timespec
        st_birthtim timespec
        st_size i64
        st_blocks i64
        st_blksize i32
        st_flags u32
        st_gen u32
        st_lspare i32
        st_qspare0 i64
        st_qspare1 i64
    @else:
        st_dev u64
        st_ino u64
        st_nlink u64
        st_mode u32
        st_uid u32
        st_gid u32
        st_pad0 i32
        st_rdev u64
        st_size i64
        st_blksize i64
        st_blocks i64
        st_atim timespec
        st_mtim timespec
        st_ctim timespec
        st_reserved0 i64
        st_reserved1 i64
        st_reserved2 i64

S_IFMT i32 = 61440
S_IFSOCK i32 = 49152
S_IFLNK i32 = 40960
S_IFREG i32 = 32768
S_IFBLK i32 = 24576
S_IFDIR i32 = 16384
S_IFCHR i32 = 8192
S_IFIFO i32 = 4096

S_IRWXU i32 = 448
S_IRUSR i32 = 256
S_IWUSR i32 = 128
S_IXUSR i32 = 64
S_IRWXG i32 = 56
S_IRWXO i32 = 7

proto stat(path char[], out &stat) i32
proto fstat(fd i32, out &stat) i32
proto lstat(path char[], out &stat) i32
proto mkdir(path char[], mode i32) i32
proto chmod(path char[], mode i32) i32
proto umask(mask i32) i32
