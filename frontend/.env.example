# ── PharmaGest frontend env template ────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in.
# Every URL the frontend uses lives here, never in source.
# Vite only exposes vars prefixed with VITE_ to the browser bundle.
# DigitalOcean App Platform: set each of these as a build-time env var.

# ── Backend URL ─────────────────────────────────────────────────────────────
# Dev:  http://localhost:8000        (Vite dev server proxies /v1/* to this)
# Prod: https://api.pharmagest.ma    (or whatever your deployed backend serves)
# If frontend + backend are served from the SAME origin in prod (single DO app
# routing /api/* to the backend), set this to an empty string and the api/client
# wrapper falls back to same-origin /v1 calls.
VITE_BACKEND_URL=http://localhost:8000