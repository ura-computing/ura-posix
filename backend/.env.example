# ── PharmaGest backend env template ─────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in.
# Every URL the backend uses lives here, never in source.
# DigitalOcean App Platform: set each of these as an app-level env var.

# ── Database ────────────────────────────────────────────────────────────────
# Dev:  postgresql+psycopg2://apcm:apcm@localhost:5432/apcm  (docker-compose)
# Prod: postgresql+psycopg2://USER:PASS@HOST:25060/defaultdb  (DO managed PG)
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/pharmagest

# ── Auth ────────────────────────────────────────────────────────────────────
# JWT_SECRET must be a real random string in prod (>= 64 chars). Rotate by changing this value.
JWT_SECRET=change-me-to-a-real-64-char-secret
JWT_ACCESS_EXPIRY_MIN=60

# Cookie flags. COOKIE_SECURE MUST be true in prod (HTTPS required) so the
# access_token cookie is never sent over plaintext.
COOKIE_SECURE=false

# ── Frontend URL (used by magic links + future CORS allow-list) ─────────────
# Dev:  http://localhost:5173
# Prod: https://app.pharmagest.ma   (or whatever you deploy to on DO)
FRONTEND_URL=http://localhost:5173

# ── SMTP (transactional email: magic links, welcome emails) ─────────────────
# Leave MAIL_USERNAME blank to fall back to stdout (no SMTP). Useful for tests.
#
# Gmail SMTP (dev): create an app password at
#   https://myaccount.google.com/apppasswords
# then set MAIL_USERNAME=youraccount@gmail.com and paste the 16-char password.
# Production: switch MAIL_SERVER to your provider (Resend, Brevo, Mailgun…) and
# verify a real sender domain so emails don't land in spam.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false