# Backend env reference (NOT consumed automatically — docker-compose passes vars
# from docker.env directly to the backend service). Kept here for parity with
# apcm-pharma's env/ layout so the client's mental model is preserved.
DATABASE_URL=postgresql+psycopg2://apcm:apcm@db:5432/apcm_demo
JWT_SECRET=demo-jwt-secret-not-for-prod-32chars-min!!
JWT_ACCESS_EXPIRY_MIN=10080
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:4173
