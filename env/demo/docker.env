# Demo environment for docker-compose.
# Copied to <repo>/.env by `make demo` so docker-compose's ${VAR:-default}
# fallbacks all resolve to demo values. Safe to commit (no real secrets).
POSTGRES_DB=apcm_demo
POSTGRES_USER=apcm
POSTGRES_PASSWORD=apcm

JWT_SECRET=demo-jwt-secret-not-for-prod-32chars-min!!
JWT_ACCESS_EXPIRY_MIN=10080
COOKIE_SECURE=false

FRONTEND_URL=http://localhost:4173
VITE_BACKEND_URL=http://localhost:8000
