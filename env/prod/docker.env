# ── Prod: Docker Compose ──────────────────────────────────────────────────────
POSTGRES_DB=apcm_prod
POSTGRES_USER=apcm_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Backend ──────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_GENERATE_WITH_python3_-c_import_secrets_print_secrets.token_urlsafe_32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# ── Frontend (Vite build args) ───────────────────────────────────────────────
VITE_API_URL=https://api.your-domain.com
VITE_BACKEND_BASE_URL=https://api.your-domain.com/
